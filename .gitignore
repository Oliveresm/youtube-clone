# =====================================================================
node_modules/
.next/
out/
.vercel/
.firebase/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env*.local

# =====================================================================
# Python (scripts / Lambda)
# =====================================================================
__pycache__/
*.pyc
.venv/
venv/

